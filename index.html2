</main>
<script>
    let scenario = {};
    let previousScreen = 'screen1';
    const assumptions = { growthRate: 0.06, waitingYears: 3, waitingMonths: 36, depositMilestoneRate: 0.20 };
    const form = document.getElementById('scenarioForm');
    const errors = document.getElementById('errors');
    const confirmPanel = document.getElementById('confirmPanel');
    const addressBox = document.getElementById('addressBox');
    const areaBox = document.getElementById('areaBox');
    const housingCostBox = document.getElementById('housingCostBox');
    const upgradeReasonBox = document.getElementById('upgradeReasonBox');
    const otherReasonBox = document.getElementById('otherReasonBox');

    function parseMoney(value) { const cleaned = String(value || '').replace(/[^0-9]/g, ''); return cleaned ? Number(cleaned) : null; }
    function money(value) { return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }).format(Math.round(value)); }
    function signedMoney(value) { return (value >= 0 ? '+' : '-') + money(Math.abs(value)); }
    function compactMillions(value) {
      let text = (value / 1000000).toFixed(2).replace(/0$/, '');
      if (text.endsWith('.')) text += '0';
      return '$' + text + 'm';
    }
    function titleCaseName(raw) {
      return String(raw || '').trim().split(/\s+/).map((word) => {
        const lower = word.toLowerCase();
        if (lower === 'and' || lower === 'or') return lower;
        if (word === '&') return '&';
        return lower.replace(/(^|[-'])[a-z]/g, (m) => m.toUpperCase());
      }).join(' ');
    }

    function isPluralName(name) {
      return /\b(and)\b|&|,/i.test(String(name || ''));
    }

    function pluralVerb(name, pluralForm, singularForm) {
      return isPluralName(name) ? pluralForm : singularForm;
    }

    function locationWithArticle() {
      if (scenario.locationType === 'address') return locationText(true);
      const loc = locationText(true);
      if (!loc) return loc;
      if (/^the\s+/i.test(loc)) return loc;
      return `the ${loc}`;
    }

    function weeklyRentFromMonthly(monthlyRent) { return Math.round((monthlyRent * 12) / 52); }
    function roundToNearest(value, nearest) { return Math.round(value / nearest) * nearest; }
    function percent(value) { return Math.round(value * 100) + '%'; }
    function showScreen(id) { document.querySelectorAll('.screen').forEach(s => s.classList.remove('active')); document.getElementById(id).classList.add('active'); window.scrollTo({ top: 0, behavior: 'smooth' }); }

    document.querySelectorAll('[data-money="true"]').forEach((input) => {
      input.addEventListener('blur', () => { const value = parseMoney(input.value); input.value = value === null ? '' : money(value); });
      input.addEventListener('focus', () => { const value = parseMoney(input.value); input.value = value === null ? '' : String(value); });
    });

    document.querySelectorAll('input[name="buyerSituation"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const situation = document.querySelector('input[name="buyerSituation"]:checked').value;
        document.getElementById('housingCost').value = '';
        if (situation === 'renting') {
          housingCostBox.classList.add('visible');
          upgradeReasonBox.classList.remove('visible');
          otherReasonBox.classList.remove('visible');
          document.getElementById('depositHelp').textContent = 'Savings or deposit you can put towards buying your home.';
        } else {
          housingCostBox.classList.remove('visible');
          upgradeReasonBox.classList.add('visible');
          document.getElementById('depositHelp').textContent = 'Savings, equity or sale proceeds you can put towards your next home.';
        }
      });
    });

    document.getElementById('upgradeReason').addEventListener('change', () => {
      otherReasonBox.classList.toggle('visible', document.getElementById('upgradeReason').value === 'Other');
    });

    document.querySelectorAll('input[name="addressKnown"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const isKnown = document.querySelector('input[name="addressKnown"]:checked').value === 'yes';
        addressBox.classList.toggle('visible', isKnown);
        areaBox.classList.toggle('visible', !isKnown);
      });
    });

    function buildScenario() {
      const situationNode = document.querySelector('input[name="buyerSituation"]:checked');
      const addressKnown = document.querySelector('input[name="addressKnown"]:checked').value;
      const rawName = document.getElementById('customerName').value.trim();
      const name = titleCaseName(rawName);
      const customerType = situationNode ? situationNode.value : '';
      const targetPurchasePrice = parseMoney(document.getElementById('purchasePrice').value);
      const contribution = parseMoney(document.getElementById('deposit').value);
      const monthlyRent = parseMoney(document.getElementById('housingCost').value);
      const targetArea = document.getElementById('targetArea').value;
      const propertyAddress = document.getElementById('address').value.trim();
      const upgradeReason = document.getElementById('upgradeReason').value;
      const upgradeReasonText = document.getElementById('otherReason').value.trim();
      const messages = [];
      if (!name) messages.push('Enter a name for the roadmap.');
      if (!customerType) messages.push('Select whether they are renting now or own and upgrading.');
      if (!targetPurchasePrice || targetPurchasePrice <= 0) messages.push('Enter a target purchase price.');
      if (addressKnown === 'no' && !targetArea) messages.push('Choose a target area.');
      if (addressKnown === 'yes' && !propertyAddress) messages.push('Enter the property address or choose Not yet.');
      if (contribution === null || contribution < 0) messages.push('Enter your contribution.');
      if (customerType === 'renting' && (monthlyRent === null || monthlyRent < 0)) messages.push('Enter the current monthly rent.');
      if (customerType === 'upgrading' && !upgradeReason) messages.push('Choose why you are upgrading.');
      if (customerType === 'upgrading' && upgradeReason === 'Other' && !upgradeReasonText) messages.push('Enter the reason for upgrading.');
      return { messages, data: { name, customerType, targetPurchasePrice, locationType: addressKnown === 'yes' ? 'address' : 'area', targetArea, propertyAddress, contribution, monthlyRent: monthlyRent || 0, upgradeReason, upgradeReasonText, depositGap: Math.max(0, targetPurchasePrice * 0.20 - contribution) } };
    }

    form.addEventListener('submit', (event) => { event.preventDefault(); const result = buildScenario(); if (result.messages.length) { errors.innerHTML = '<strong>Fix these items before reviewing the roadmap:</strong><ul>' + result.messages.map(m => `<li>${m}</li>`).join('') + '</ul>'; errors.classList.add('visible'); confirmPanel.classList.remove('visible'); document.getElementById('screen1').classList.remove('confirm-mode'); return; } errors.classList.remove('visible'); scenario = result.data; renderConfirmation(); });

    function locationText(full = false) { return scenario.locationType === 'address' ? (scenario.propertyAddress || 'this property') : (full ? scenario.targetArea : `your ${scenario.targetArea} target`); }

    function renderConfirmation() {
      const startingPoint = scenario.customerType === 'renting' ? 'Renting now' : 'Own and upgrading';
      const routeText = scenario.customerType === 'renting' ? 'Show Me the Cost of Waiting →' : 'Show Me the Cost of Compromise →';
      const housingRow = scenario.customerType === 'renting' ? `<tr><td>Monthly rent leak</td><td class="confirm-detail">${money(scenario.monthlyRent)}</td><td>The amount you’ll soon be redirecting into your own wealth, not someone else’s.</td></tr>` : `<tr><td>Upgrade reason</td><td class="confirm-detail">${scenario.upgradeReason === 'Other' ? scenario.upgradeReasonText : scenario.upgradeReason}</td><td>The reason behind the next move.</td></tr>`;
      document.getElementById('confirmNameInline').textContent = scenario.name;
      document.getElementById('confirmRows').innerHTML = `<tr><td>Who this is for</td><td class="confirm-detail">${scenario.name}</td><td>Your names on the title deed—personalised for your future.</td></tr><tr><td>Starting point</td><td class="confirm-detail">${startingPoint}</td><td>${scenario.customerType === 'renting' ? 'Breaking the cycle. This is the last time you’ll fund a landlord’s retirement.' : 'Making your next move. This roadmap is built around the home you want next.'}</td></tr><tr><td>Target purchase price</td><td class="confirm-detail">${money(scenario.targetPurchasePrice)}</td><td>The price of your new front door. We’re locking in this goal today.</td></tr><tr><td>${scenario.locationType === 'address' ? 'Your property target' : 'Your new neighbourhood'}</td><td class="confirm-detail">${locationText(true)}</td><td>Where life happens. We’ve shaped this roadmap around your target location.</td></tr><tr><td>Your contribution</td><td class="confirm-detail">${money(scenario.contribution)}</td><td>${scenario.customerType === 'renting' ? 'Savings or deposit you can put towards buying your home.' : 'Savings, equity or sale proceeds you can put towards your next home.'}</td></tr>${housingRow}`;
      document.getElementById('emotionalClose').innerHTML = `Everything look right?<br><br>By bridging your ${money(scenario.depositGap)} gap today, you aren't just buying a house—you’re securing a home in ${locationText(true)} while the market is still in reach.`;
      document.getElementById('routeButton').textContent = routeText;
      document.getElementById('screen1').classList.add('confirm-mode');
      confirmPanel.classList.add('visible'); confirmPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.getElementById('routeButton').addEventListener('click', () => { const result = buildScenario(); if (result.messages.length) return; scenario = result.data; if (scenario.customerType === 'renting') { renderCostOfWaiting(); showScreen('screen2'); } else { renderCostOfCompromise(); showScreen('screenCompromise'); } });
    document.getElementById('editButton').addEventListener('click', () => { confirmPanel.classList.remove('visible'); document.getElementById('screen1').classList.remove('confirm-mode'); });
    document.getElementById('resetButton').addEventListener('click', () => location.reload());

    function calcValues() {
      const settings = scenario.customerType === 'upgrading' ? readDelaySettings('upg') : readDelaySettings('');
      const futurePrice = scenario.targetPurchasePrice * Math.pow(1 + settings.growthRate, settings.years);
      const priceHike = Math.round(futurePrice - scenario.targetPurchasePrice);
      return { futurePrice, priceHike, growthRate: settings.growthRate, years: settings.years, label: settings.label };
    }

    function page2MarketSourceText() {
      if (scenario.locationType === 'address') return `${scenario.propertyAddress} and the surrounding local market`;
      return scenario.targetArea || 'your selected area';
    }

    function readDelaySettings(prefix = '') {
      const growthSelect = document.getElementById(prefix ? prefix + 'MarketGrowthSelect' : 'marketGrowthSelect');
      const timelineSelect = document.getElementById(prefix ? prefix + 'TimelineSelect' : 'timelineSelect');
      const customWrap = document.getElementById(prefix ? prefix + 'CustomGrowthWrap' : 'customGrowthWrap');
      const customInput = document.getElementById(prefix ? prefix + 'CustomGrowthRate' : 'customGrowthRate');
      const selected = growthSelect ? growthSelect.value : String(assumptions.growthRate);
      const years = timelineSelect ? Number(timelineSelect.value) : assumptions.waitingYears;
      let growthRate = assumptions.growthRate;
      let label = 'AI Area Trend';
      if (selected === 'custom') {
        customWrap && customWrap.classList.add('visible');
        const raw = parseFloat(String(customInput && customInput.value ? customInput.value : '').replace('%',''));
        growthRate = Number.isFinite(raw) && raw >= 0 ? raw / 100 : assumptions.growthRate;
        label = 'Custom';
      } else {
        customWrap && customWrap.classList.remove('visible');
        growthRate = Number(selected);
        if (selected === '0.04') label = 'Conservative';
        if (selected === '0.06') label = 'AI Area Trend';
        if (selected === '0.07') label = 'Active';
      }
      return { growthRate, years, label };
    }

    function calcDelayValues(settings) {
      const futurePrice = scenario.targetPurchasePrice * Math.pow(1 + settings.growthRate, settings.years);
      const priceHike = Math.round(futurePrice - scenario.targetPurchasePrice);
      return { futurePrice, priceHike };
    }

    function yearsText(years) { return `${years} ${years === 1 ? 'year' : 'years'}`; }
    function growthPercent(rate) { return (rate * 100).toFixed(rate * 100 % 1 === 0 ? 0 : 1) + '%'; }

    function renderCostOfWaiting() {
      const settings = readDelaySettings('');
      const { futurePrice, priceHike } = calcDelayValues(settings);
      const months = settings.years * 12;
      const rentDrain = roundToNearest(scenario.monthlyRent * months, 100);
      const weeklyRent = Math.round((scenario.monthlyRent * 12) / 52);
      const yText = yearsText(settings.years);
      document.getElementById('scenarioShown').textContent = `Scenario shown: ${settings.label} ${growthPercent(settings.growthRate)} over ${yText}`;
      document.getElementById('personalLine').textContent = `${scenario.name}, this is what waiting could mean for ${locationText(false)}.`;
      document.getElementById('marketInsightText').textContent = 'Based on local data for your property and suburb, our AI has mapped out your growth potential. Select a market speed and payout timeline from the dropdowns to update your personalised wealth projection.';
      document.getElementById('waitingTax').textContent = money(priceHike);
      document.getElementById('landlordLine').textContent = `Whilst you have paid ${money(rentDrain)} to your landlord.`;
      document.getElementById('moveToday').textContent = compactMillions(scenario.targetPurchasePrice);
      document.getElementById('moveFuture').textContent = compactMillions(futurePrice);
      document.getElementById('moveCaption').textContent = `The goalposts move by ${money(priceHike)}.`;
      document.getElementById('priceHikeText').textContent = `Using the selected market outlook, the same home rises from ${compactMillions(scenario.targetPurchasePrice)} to ${compactMillions(futurePrice)} over your selected timeline.`;
      document.getElementById('priceHikeCost').textContent = money(priceHike);
      document.getElementById('rentDrainText').textContent = `At ${money(weeklyRent)}/week, ${yText} of renting costs ${money(rentDrain)}.`;
      document.getElementById('rentDrainCost').textContent = money(rentDrain);
      document.getElementById('rentWaitLabel').textContent = `Wait ${yText}`;
      document.getElementById('choiceWaitGrowth').textContent = `${money(priceHike)} growth`;
      document.getElementById('choiceWaitCopy').textContent = `Whilst you have paid ${money(rentDrain)} in rent.`;
      document.getElementById('assumptionLine').innerHTML = `Assumptions:<br>${settings.label} market outlook (${growthPercent(settings.growthRate)} p.a.) • Home price today ${money(scenario.targetPurchasePrice)} • Rent ${money(weeklyRent)}/week • ${yText} waiting period`;
    }

    function getUpgradeCopy(priceHike, years = assumptions.waitingYears) {
      const other = scenario.upgradeReasonText || 'the move you want';
      const yText = yearsText(years);
      const map = { 'More space': [`${yText} of making do with less space.`, `Pay ${money(priceHike)} more while living in a cramped home.`], 'Growing family': [`${yText} of your family outgrowing their space.`, `Pay ${money(priceHike)} more while your family lacks room.`], 'Better location': [`${yText} of the wrong commute.`, `Pay ${money(priceHike)} more and keep the long commute.`], 'Better quality home': [`${yText} in a home that doesn’t fit.`, `Pay ${money(priceHike)} more while living in a house you’ve outgrown.`], 'Lifestyle change': [`${yText} of putting your life on hold.`, `Pay ${money(priceHike)} more and put your life on hold.`], 'Other': [`${yText} without ${other}.`, `Pay ${money(priceHike)} more and stay stuck where you are.`] };
      return map[scenario.upgradeReason] || map.Other;
    }

    function renderCostOfCompromise() {
      const settings = readDelaySettings('upg');
      const { futurePrice, priceHike } = calcDelayValues(settings);
      const [delayLine, waitLine] = getUpgradeCopy(priceHike, settings.years);
      const reason = scenario.upgradeReason === 'Other' ? scenario.upgradeReasonText : scenario.upgradeReason;
      const yText = yearsText(settings.years);
      document.getElementById('upgPersonalLine').textContent = `${scenario.name}, this is what waiting could mean for ${locationText(false)}.`;
      document.getElementById('upgMarketInsightText').textContent = 'Based on local data for your property and suburb, our AI has mapped out your growth potential. Select a market speed and payout timeline from the dropdowns to update your personalised wealth projection.';
      document.getElementById('upgWaitingTax').textContent = money(priceHike);
      document.getElementById('upgGapLine').textContent = `Whilst the gap between your current home and your next home grows by ${money(priceHike)}.`;
      document.getElementById('upgMoveToday').textContent = compactMillions(scenario.targetPurchasePrice);
      document.getElementById('upgMoveFuture').textContent = compactMillions(futurePrice);
      document.getElementById('upgMoveCaption').textContent = `The step-up gap grows by ${money(priceHike)}.`;
      document.getElementById('upgPriceHikeText').textContent = `As the market moves, the “step up” becomes more expensive every day. Using the selected market outlook, the same home rises from ${compactMillions(scenario.targetPurchasePrice)} to ${compactMillions(futurePrice)} over your selected timeline.`;
      document.getElementById('upgPriceHikeCost').textContent = money(priceHike);
      document.getElementById('upgLifestyleText').textContent = `Whether it’s more space for the kids or a better location for your sanity, you can’t get those ${yText} back.`;
      document.getElementById('upgLifestyleYears').textContent = yText;
      document.getElementById('upgLifestyleCostText').textContent = delayLine;
      document.getElementById('upgWaitLabel').textContent = `Wait ${yText}`;
      document.getElementById('upgChoiceWaitGrowth').textContent = `${money(priceHike)} in market growth`;
      document.getElementById('upgChoiceWaitCopy').textContent = waitLine;
      document.getElementById('upgAssumptionLine').innerHTML = `Assumptions:<br>${settings.label} market outlook (${growthPercent(settings.growthRate)} p.a.) • Home price today ${money(scenario.targetPurchasePrice)} • ${yText} waiting period • Target: ${locationText(true)} • Upgrader pathway based on ${reason}`;
    }

    function renderBridge() {
      const hurdle = scenario.targetPurchasePrice * assumptions.depositMilestoneRate;
      const gap = Math.max(0, hurdle - scenario.contribution);
      const total = scenario.contribution + gap;
      const marketLabel = scenario.locationType === 'address' ? 'this property' : `${scenario.targetArea} market`;
      const targetLabel = scenario.locationType === 'address' ? 'this property' : `${scenario.targetArea} home`;
      document.getElementById('bridgeHeroSubtitle').textContent = `${scenario.name}, here is how BuySooner could help bridge the gap for your ${targetLabel}.`;
      document.getElementById('targetValue').textContent = money(scenario.targetPurchasePrice);
      document.getElementById('hurdleValue').textContent = money(hurdle);
      document.getElementById('gapValue').textContent = money(gap);
      document.getElementById('yourContribution').textContent = money(scenario.contribution);
      document.getElementById('buySoonerBridge').textContent = money(gap);
      document.getElementById('totalDeposit').textContent = money(total);
      document.getElementById('bridgeResultLine').textContent = 'The Result: BuySooner bridges the missing piece so you can move from planning to buying.';
      document.getElementById('lockInCopy').textContent = `You secure the ${money(scenario.targetPurchasePrice)} price today. Any future growth in the ${marketLabel} works for you, not against you.`;

      if (scenario.customerType === 'renting') {
        document.getElementById('shiftOneTitle').textContent = 'From Saving to Owning';
        document.getElementById('shiftOneCopy').textContent = 'You stop “chasing” the full deposit and start building equity in your own home from Day 1.';
        document.getElementById('shiftThreeTitle').textContent = 'From Renting to Investing';
        document.getElementById('rentCopy').textContent = `Your ${money(scenario.monthlyRent)} monthly rent drain stops. Your housing payments start supporting your own future, not your landlord’s.`;
        document.getElementById('bridgeFooterStatement').textContent = 'You bring the contribution. BuySooner provides the bridge. Together, we bridge the deposit barrier so you can own the future, sooner.';
      } else {
        document.getElementById('shiftOneTitle').textContent = 'From Saving to Moving';
        document.getElementById('shiftOneCopy').textContent = 'You stop waiting for the full deposit and move toward the home that fits your next stage.';
        document.getElementById('shiftThreeTitle').textContent = 'From Compromise to Moving Forward';
        document.getElementById('rentCopy').textContent = 'Your move starts now. The waiting, compromise and uncertainty are redirected toward the home that better fits your life.';
        document.getElementById('bridgeFooterStatement').textContent = 'You bring the contribution. BuySooner provides the bridge. Together, we close the gap so you can move into the home that fits your life, sooner.';
      }
    }

    function renderPathToOwnership() {
      const { futurePrice, priceHike, growthRate, years } = calcValues();
      const waitingMonths = Math.round(years * 12);
      const rentRedirected = roundToNearest((scenario.monthlyRent || 0) * waitingMonths, 100);
      const bridgeAmount = Math.max(0, scenario.targetPurchasePrice * assumptions.depositMilestoneRate - scenario.contribution);
      const pricingMultiplier = 5;
      const contributionRatio = scenario.targetPurchasePrice > 0 ? bridgeAmount / scenario.targetPurchasePrice : 0;
      const annualParticipationRate = contributionRatio / pricingMultiplier;
      const buySoonerCost = Math.round(futurePrice * annualParticipationRate * years);
      const growthRetained = priceHike - buySoonerCost;
      const refinanceVerb = pluralVerb(scenario.name, 'refinance', 'refinances');
      const repayVerb = pluralVerb(scenario.name, 'repay', 'repays');
      const moveVerb = pluralVerb(scenario.name, 'move', 'moves');

      document.getElementById('ownHeroHeading').textContent = `${yearsText(years)} later, ${scenario.name} ${refinanceVerb}, ${repayVerb} BuySooner, and ${moveVerb} to full ownership.`;
      document.getElementById('ownershipTimelineTitle').textContent = `Path to 100% ownership — ${yearsText(years)} pathway`;
      document.getElementById('ownGrowthCopy').textContent = `Their ${compactMillions(scenario.targetPurchasePrice)} home grew at ${growthPercent(growthRate)} p.a. to ${compactMillions(futurePrice)} instead of chasing it.`;
      document.getElementById('ownGrowth').textContent = signedMoney(priceHike);
      document.getElementById('ownCapitalCopy').textContent = `Return of the original ${money(bridgeAmount)} contribution.`;
      document.getElementById('ownCapital').textContent = money(bridgeAmount);
      document.getElementById('ownCost').textContent = '-' + money(buySoonerCost);
      document.getElementById('ownTotalCost').textContent = '-' + money(buySoonerCost);
      document.getElementById('ownGrowthRetained').innerHTML = `${signedMoney(growthRetained)}<span>Home Equity Retained</span>`;

      if (scenario.customerType === 'renting') {
        document.getElementById('ownResultOne').textContent = `Paid ${money(rentRedirected)} towards their own home, not their landlord’s.`;
        document.getElementById('ownResultThree').textContent = 'They did not just find a place to live — they built a foundation for their future.';
      } else {
        document.getElementById('ownResultOne').textContent = `Moved into the home that better fits their life ${yearsText(years)} sooner.`;
        document.getElementById('ownResultThree').textContent = `They did not just move house — they secured the next home in ${locationWithArticle()}.`;
      }
    }

    ['marketGrowthSelect', 'timelineSelect', 'customGrowthRate'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', renderCostOfWaiting);
      if (el) el.addEventListener('change', renderCostOfWaiting);
    });
    ['upgMarketGrowthSelect', 'upgTimelineSelect', 'upgCustomGrowthRate'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', renderCostOfCompromise);
      if (el) el.addEventListener('change', renderCostOfCompromise);
    });

    document.getElementById('toBridgeFromRent').addEventListener('click', () => { renderBridge(); previousScreen = 'screen2'; showScreen('screenBridge'); });
    document.getElementById('toBridgeFromUpg').addEventListener('click', () => { renderBridge(); previousScreen = 'screenCompromise'; showScreen('screenBridge'); });
    document.getElementById('backFromRent').addEventListener('click', () => showScreen('screen1'));
    document.getElementById('backFromUpg').addEventListener('click', () => showScreen('screen1'));
    document.getElementById('backFromBridge').addEventListener('click', () => showScreen(previousScreen));
    document.getElementById('toOwnership').addEventListener('click', () => { renderPathToOwnership(); previousScreen = 'screenBridge'; showScreen('screenOwnership'); });
    document.getElementById('backFromOwnership').addEventListener('click', () => showScreen('screenBridge'));
    document.getElementById('toReadySooner').addEventListener('click', () => { renderReadyScreen(); previousScreen = 'screenOwnership'; showScreen('screenReady'); });
    document.getElementById('applyNowButton').addEventListener('click', () => alert('Application handoff placeholder'));
    document.getElementById('saveRoadmapButton').addEventListener('click', () => alert('Save roadmap placeholder'));

    function renderReadyScreen() {
      const heading = scenario.name ? `${scenario.name}, next steps to getting the keys to your new home` : 'Your next steps to getting the keys to your new home';
      document.getElementById('readyNextHeading').textContent = heading;
      if (scenario.customerType === 'upgrading') {
        document.getElementById('reportCostItem').innerHTML = '<strong>The Step-Up Cost</strong> — The cost of waiting while your next home moves further out of reach.';
      } else {
        document.getElementById('reportCostItem').innerHTML = '<strong>The Waiting Tax</strong> — The cost of staying on the sidelines while the market moves.';
      }
    }
  </script>
</body>
</html>
